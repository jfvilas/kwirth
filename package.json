{
    "id": "wrkactjob",
    "name": "@jfvilas/kwirth-plugin-wrkactjob",
    "displayName": "WRKACTJOB",
    "extensionType": "plugin",
    "publisher": "@jfvilas",
    "version": "0.1.0",
    "tags": [
        "operations",
        "kubernetes",
        "emulator"
    ],
    "description": "WRKACTJOB channel plugin for Kwirth - IBM i Work with Active Jobs on a 5250 terminal (24x80 or 27x132, colour or green screen), where namespaces are subsystems and pods are jobs",
    "icon": "Terminal",
    "license": "MIT",
    "website": "https://github.com/jfvilas/kwirth/tree/master/plugins/wrkactjob",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jfvilas/kwirth.git",
        "directory": "plugins/wrkactjob"
    },
    "requiresRestart": false,
    "requiresExtension": [
        {
            "extensionType": "dce",
            "id": "blockterm",
            "minVersion": "0.2.0"
        }
    ],
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "watch": "node watch.mjs",
        "test": "node tests/run.mjs"
    },
    "dependencies": {
        "@kwirthmagnify/kwirth-common": "^0.5.96",
        "@kwirthmagnify/kwirth-common-back": "^0.6.19",
        "@kwirthmagnify/kwirth-common-front": "^0.5.83"
    },
    "devDependencies": {
        "@jfvilas/kwirth-dce-blockterm": "^0.2.0",
        "@kubernetes/client-node": "^1.4.0",
        "@mui/icons-material": "7.1.2",
        "@mui/material": "7.1.2",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.13",
        "@types/react": "^18.3.0",
        "c8": "^12.0.0",
        "esbuild": "^0.27.2",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "typescript": "^5.4.0"
    }
}
